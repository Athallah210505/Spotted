# Local foundation runs with these defaults. Never commit real secrets.
APP_ORIGIN=http://localhost:3000

# Set both together to enable Supabase client usage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Future Maps feature: browser key restricted by HTTP referrer + Maps JS API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Future Places adapter: no paid requests are implemented in the foundation.
GOOGLE_PLACES_API_KEY=
PAID_APIS_ENABLED=false
GOOGLE_PLACES_DAILY_CALL_LIMIT=0

# Future analytics: leave unset until collection/consent settings are reviewed.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
